NODE_ENV=development
PORT=8080
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://v79commerce:change_me_local_only@postgres:5432/v79commerce?schema=public
REDIS_URL=redis://redis:6379

# Use hub in production. dev is rejected automatically when NODE_ENV=production.
AUTH_MODE=dev
JWT_ISSUER=https://hub.v79sl.com
JWT_AUDIENCE=v79-commerce
HUB_JWKS_URL=https://hub.v79sl.com/.well-known/jwks.json
HUB_INTERNAL_URL=http://v79-hub:3040
POS_PUBLIC_URL=https://pos.v79sl.com
POS_SESSION_HOURS=8
# The same 32+ character service secret already configured in V79 Hub.
# This authenticates Hub provisioning and read-only summaries, not user logins.
V79_PLATFORM_SHARED_SECRET=
CORS_ORIGINS=http://localhost:3000,https://pos.v79sl.com

REPLENISHMENT_INTERVAL_MINUTES=60
LOG_LEVEL=info

BOOTSTRAP_TENANT_NAME=Vision79 Demo
BOOTSTRAP_TENANT_SLUG=vision79-demo
BOOTSTRAP_OWNER_USER_ID=dev-owner

GIFT_CARD_PEPPER=replace-with-long-random-secret
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
TRUST_PROXY=true
BACKUP_RETENTION_DAYS=30
