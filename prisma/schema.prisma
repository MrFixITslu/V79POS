generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LocationType {
  STORE
  WAREHOUSE
  OFFICE
  POPUP
  MOBILE
}
enum ProductType {
  STANDARD
  VARIANT
  SERVICE
  BUNDLE
  KIT
  SERIALIZED
  LOT_TRACKED
  WEIGHTED
  NON_STOCK
}
enum InventoryMovementType {
  PURCHASE_RECEIPT
  SALE
  TECHNICIAN_USE
  SALE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_GAIN
  ADJUSTMENT_LOSS
  DAMAGE
  EXPIRY
  QUARANTINE_IN
  QUARANTINE_RELEASE
  RESERVATION
  RESERVATION_RELEASE
}
enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  CANCELLED
}
enum SaleStatus {
  OPEN
  COMPLETED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}
enum ReturnStatus {
  COMPLETED
  VOIDED
}
enum StockTransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}
enum StockTransferPurpose {
  GENERAL
  TECHNICIAN_ISSUE
  TECHNICIAN_RETURN_GOOD
  TECHNICIAN_RETURN_FAULTY
}
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum PaymentMethod {
  CASH
  CARD
  EXTERNAL_TERMINAL
  BANK_TRANSFER
  MOBILE_WALLET
  STORE_CREDIT
  GIFT_CARD
  LOYALTY_POINTS
  OTHER
}
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUBMITTED
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}
enum ShipmentStatus {
  PLANNED
  CONFIRMED
  PREPARING
  DISPATCHED
  IN_TRANSIT
  ARRIVED_CUSTOMS
  CUSTOMS_RELEASED
  OUT_FOR_DELIVERY
  RECEIVED
  EXCEPTION
  CANCELLED
}
enum ReplenishmentStatus {
  HEALTHY
  PLAN
  ORDER_SOON
  ORDER_NOW
  STOCKOUT_RISK
  STOCKED_OUT
}
enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}
enum RegisterSessionStatus {
  OPEN
  CLOSED
}
enum CashMovementType {
  PAID_IN
  PAID_OUT
  CASH_DROP
  CASH_PICKUP
}
enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}
enum StockCountType {
  FULL
  CYCLE
  BLIND
}
enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}
enum ValueTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}
enum GiftCardStatus {
  ACTIVE
  BLOCKED
  EXPIRED
  DEPLETED
}
enum PaymentIntentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}
enum CommerceOrderType {
  QUOTE
  ORDER
  LAYAWAY
  INVOICE
}
enum CommerceOrderStatus {
  DRAFT
  SENT
  ACCEPTED
  PARTIALLY_PAID
  PAID
  FULFILLING
  COMPLETED
  CANCELLED
  EXPIRED
}
enum SerialStatus {
  AVAILABLE
  RESERVED
  SOLD
  IN_TRANSIT
  DAMAGED
  RETIRED
  INSTALLED
}
enum FulfillmentMethod {
  PICKUP
  LOCAL_DELIVERY
  SHIPMENT
}
enum FulfillmentStatus {
  PENDING
  PICKING
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}
enum CommissionBasis {
  REVENUE
  GROSS_PROFIT
}
enum ShiftStatus {
  OPEN
  CLOSED
}
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("XCD")
  timezone  String   @default("America/St_Lucia")
  active    Boolean  @default(true)
  offlineSalesEnabled Boolean @default(true)
  offlineMaxSnapshotHours Int @default(72)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations     Location[]
  products      Product[]
  suppliers     Supplier[]
  memberships   Membership[]
  roles         TenantRole[]
  customers     Customer[]
  registers     Register[]
  sales         Sale[]
  registerSessions RegisterSession[]
  cashMovements CashMovement[]
  stockCounts StockCount[]
  priceLists PriceList[]
  promotions Promotion[]
  loyaltyProgram LoyaltyProgram?
  storeCreditAccounts StoreCreditAccount[]
  loyaltyAccounts LoyaltyAccount[]
  giftCards GiftCard[]
  paymentConnections PaymentProviderConnection[]
  paymentIntents PaymentIntent[]
  devices Device[]
  catalogRevisions CatalogRevision[]
  inventoryExceptions InventoryException[]
  integrationEndpoints IntegrationEndpoint[]
  commerceOrders CommerceOrder[]
  fulfillments Fulfillment[]
  teamProfiles TeamProfile[]
  shifts Shift[]
  commissions CommissionEntry[]
  purchaseOrders PurchaseOrder[]
}

model TenantRole {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  builtIn     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model RolePermission {
  id         String     @id @default(cuid())
  roleId     String
  permission String
  role       TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([permission])
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleKey   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role           TenantRole           @relation(fields: [tenantId, roleKey], references: [tenantId, key], onDelete: Restrict)
  locationAccess UserLocationAccess[]
  profile TeamProfile?

  @@unique([tenantId, userId])
  @@index([userId, active])
}

model UserLocationAccess {
  id           String     @id @default(cuid())
  membershipId String
  locationId   String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([membershipId, locationId])
  @@index([locationId])
}

model Location {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  code      String
  type      LocationType
  custodianUserId String?
  active    Boolean      @default(true)
  address   Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances         InventoryBalance[]
  movements        InventoryLedger[]
  reservations     InventoryReservation[]
  registers        Register[]
  sales            Sale[]
  commerceOrders   CommerceOrder[]
  fulfillments     Fulfillment[]
  shifts           Shift[]
  locationAccess   UserLocationAccess[]
  receipts         GoodsReceipt[]
  stockCounts      StockCount[]
  devices          Device[]
  inventoryExceptions InventoryException[]
  lots             InventoryLot[]
  serialNumbers    InventorySerial[]
  purchaseOrders   PurchaseOrder[]
  costLayers       InventoryCostLayer[]
  transfersOut     StockTransfer[] @relation("TransferFrom")
  transfersIn      StockTransfer[] @relation("TransferTo")

  @@unique([tenantId, code])
  @@unique([tenantId, custodianUserId])
  @@index([tenantId, active])
}

model Register {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  name       String
  code       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sales    Sale[]
  sessions RegisterSession[]
  devices Device[]

  @@unique([tenantId, code])
  @@index([tenantId, locationId, active])
}

model Product {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  description String?
  productType ProductType
  category    String?
  brand       String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([tenantId, active])
  @@index([tenantId, category])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  tenantId    String
  sku         String
  barcode     String?
  name        String
  baseCost    Decimal  @default(0) @db.Decimal(18,4)
  sellPrice   Decimal  @db.Decimal(18,4)
  taxRate     Decimal  @default(0) @db.Decimal(7,6)
  trackStock  Boolean  @default(true)
  requiresExpiry Boolean @default(false)
  active      Boolean  @default(true)
  attributes  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  balances      InventoryBalance[]
  movements     InventoryLedger[]
  reservations  InventoryReservation[]
  supplierMap   SupplierProduct[]
  policies      ReplenishmentPolicy[]
  saleLines     SaleLine[]
  poLines       PurchaseOrderLine[]
  receiptLines  GoodsReceiptLine[]
  shipmentLines ShipmentLine[]
  costLayers    InventoryCostLayer[]
  transferLines StockTransferLine[]
  returnLines   SaleReturnLine[]
  stockCountLines StockCountLine[]
  priceListItems PriceListItem[]
  promotionProducts PromotionProduct[]
  catalogSnapshotItems CatalogSnapshotItem[]
  commerceOrderLines CommerceOrderLine[]
  lots InventoryLot[]
  serialNumbers InventorySerial[]
  saleLineLots SaleLineLotAllocation[]
  saleLineSerials SaleLineSerial[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([productId, active])
}

model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  externalRef  String?
  name         String
  email        String?
  phone        String?
  marketingConsent Boolean @default(false)
  notes        String?
  priceListId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  sales  Sale[]
  commerceOrders CommerceOrder[]
  storeCreditAccount StoreCreditAccount?
  loyaltyAccount LoyaltyAccount?

  @@index([tenantId, name])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model InventoryBalance {
  id               String   @id @default(cuid())
  tenantId         String
  locationId       String
  productVariantId String
  onHand           Decimal  @default(0) @db.Decimal(18,4)
  reserved         Decimal  @default(0) @db.Decimal(18,4)
  committed        Decimal  @default(0) @db.Decimal(18,4)
  quarantined      Decimal  @default(0) @db.Decimal(18,4)
  damaged          Decimal  @default(0) @db.Decimal(18,4)
  expired          Decimal  @default(0) @db.Decimal(18,4)
  updatedAt        DateTime @updatedAt

  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locationId, productVariantId])
  @@index([tenantId, productVariantId])
}

model InventoryLedger {
  id               String   @id @default(cuid())
  tenantId         String
  locationId       String
  productVariantId String
  movementType     InventoryMovementType
  deltaQty         Decimal  @db.Decimal(18,4)
  referenceType    String
  referenceId      String
  reason           String?
  performedBy      String?
  deviceId         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  location       Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([tenantId, locationId, productVariantId, createdAt])
  @@index([tenantId, referenceType, referenceId])
}

model InventoryCostLayer {
  id               String   @id @default(cuid())
  tenantId         String
  locationId       String
  productVariantId String
  sourceType       String
  sourceId         String
  quantityReceived Decimal  @db.Decimal(18,4)
  quantityRemaining Decimal @db.Decimal(18,4)
  unitCost         Decimal  @db.Decimal(18,4)
  receivedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  location       Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([tenantId, locationId, productVariantId, receivedAt])
  @@index([tenantId, sourceType, sourceId])
}

model InventoryReservation {
  id               String            @id @default(cuid())
  tenantId         String
  locationId       String
  productVariantId String
  referenceType    String
  referenceId      String
  quantity         Decimal           @db.Decimal(18,4)
  status           ReservationStatus @default(ACTIVE)
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([tenantId, referenceType, referenceId])
  @@index([tenantId, locationId, productVariantId, status])
}

model Sale {
  id          String     @id @default(cuid())
  tenantId    String
  locationId  String
  registerId  String?
  registerSessionId String?
  deviceId String?
  clientReference String?
  offline Boolean @default(false)
  customerId  String?
  number      String
  status      SaleStatus @default(OPEN)
  currency    String
  subtotal    Decimal    @db.Decimal(18,4)
  discount    Decimal    @default(0) @db.Decimal(18,4)
  tax         Decimal    @default(0) @db.Decimal(18,4)
  total       Decimal    @db.Decimal(18,4)
  amountPaid  Decimal    @default(0) @db.Decimal(18,4)
  changeDue   Decimal    @default(0) @db.Decimal(18,4)
  createdBy   String
  salespersonUserId String?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  register Register? @relation(fields: [registerId], references: [id], onDelete: SetNull)
  registerSession RegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  lines    SaleLine[]
  payments Payment[]
  returns  SaleReturn[]
  appliedPromotions SaleAppliedPromotion[]
  fulfillments Fulfillment[]
  commissions CommissionEntry[]

  @@unique([tenantId, number])
  @@unique([tenantId, clientReference])
  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, customerId, createdAt])
}

model SaleLine {
  id               String  @id @default(cuid())
  saleId           String
  productVariantId String
  sku              String
  description      String
  quantity         Decimal @db.Decimal(18,4)
  unitPrice        Decimal @db.Decimal(18,4)
  discount         Decimal @default(0) @db.Decimal(18,4)
  taxRate          Decimal @default(0) @db.Decimal(7,6)
  taxAmount        Decimal @default(0) @db.Decimal(18,4)
  lineTotal        Decimal @db.Decimal(18,4)
  unitCostSnapshot Decimal @default(0) @db.Decimal(18,4)

  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  returnLines    SaleReturnLine[]
  fulfillmentLines FulfillmentLine[]
  lotAllocations SaleLineLotAllocation[]
  serials SaleLineSerial[]

  @@index([saleId])
  @@index([productVariantId])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  saleId      String?
  commerceOrderId String?
  registerSessionId String?
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(18,4)
  provider    String?
  providerRef String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sale Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)
  commerceOrder CommerceOrder? @relation(fields: [commerceOrderId], references: [id], onDelete: Cascade)
  registerSession RegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  intent PaymentIntent?

  @@index([tenantId, saleId])
  @@index([tenantId, commerceOrderId])
  @@index([tenantId, registerSessionId])
  @@index([tenantId, providerRef])
}

model SaleReturn {
  id        String       @id @default(cuid())
  tenantId  String
  saleId    String
  number    String
  status    ReturnStatus @default(COMPLETED)
  reason    String
  total     Decimal      @db.Decimal(18,4)
  createdBy String
  createdAt DateTime     @default(now())

  sale    Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  lines   SaleReturnLine[]
  refunds Refund[]

  @@unique([tenantId, number])
  @@index([tenantId, saleId, createdAt])
}

model SaleReturnLine {
  id               String  @id @default(cuid())
  saleReturnId     String
  saleLineId       String
  productVariantId String
  quantity         Decimal @db.Decimal(18,4)
  refundAmount     Decimal @db.Decimal(18,4)
  unitCostSnapshot Decimal @db.Decimal(18,4)
  restocked        Boolean @default(true)

  saleReturn     SaleReturn     @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleLine       SaleLine       @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  lotAllocations SaleReturnLotAllocation[]
  serials SaleReturnSerial[]

  @@index([saleReturnId])
  @@index([saleLineId])
}

model Refund {
  id           String        @id @default(cuid())
  tenantId     String
  saleReturnId String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(18,4)
  provider     String?
  providerRef  String?
  createdAt    DateTime      @default(now())

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([tenantId, saleReturnId])
}


model SaleReturnLotAllocation {
  id               String @id @default(cuid())
  saleReturnLineId String
  lotId            String
  quantity         Decimal @db.Decimal(18,4)

  returnLine SaleReturnLine @relation(fields: [saleReturnLineId], references: [id], onDelete: Cascade)
  lot        InventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  @@unique([saleReturnLineId, lotId])
}

model SaleReturnSerial {
  id               String @id @default(cuid())
  saleReturnLineId String
  serialId         String

  returnLine SaleReturnLine @relation(fields: [saleReturnLineId], references: [id], onDelete: Cascade)
  serial     InventorySerial @relation(fields: [serialId], references: [id], onDelete: Restrict)
  @@unique([saleReturnLineId, serialId])
}

model StockTransfer {
  id             String              @id @default(cuid())
  tenantId       String
  number         String
  fromLocationId String
  toLocationId   String
  purpose        StockTransferPurpose @default(GENERAL)
  technicianUserId String?
  jobReference String?
  status         StockTransferStatus @default(REQUESTED)
  notes          String?
  createdBy      String
  approvedBy     String?
  dispatchedBy   String?
  receivedBy     String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  fromLocation Location            @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location            @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines        StockTransferLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
}

model StockTransferLine {
  id               String  @id @default(cuid())
  stockTransferId  String
  productVariantId String
  quantity         Decimal @db.Decimal(18,4)
  unitCostSnapshot Decimal? @db.Decimal(18,4)

  transfer       StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  lotAllocations StockTransferLotAllocation[]
  serialAllocations StockTransferSerialAllocation[]

  @@index([stockTransferId])
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  currency       String   @default("XCD")
  quotedLeadDays Int?
  email          String?
  phone          String?
  paymentTerms   String?
  minimumOrderValue Decimal? @db.Decimal(18,4)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId, active])
}

model SupplierProduct {
  id               String   @id @default(cuid())
  tenantId         String
  supplierId       String
  productVariantId String
  supplierSku      String?
  unitCost         Decimal  @db.Decimal(18,4)
  minimumOrderQty  Decimal  @default(0) @db.Decimal(18,4)
  casePack         Decimal  @default(1) @db.Decimal(18,4)
  preferred        Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productVariantId])
  @@index([tenantId, productVariantId, active])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  tenantId       String
  supplierId     String
  shipToLocationId String
  number         String
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime?
  expectedAt     DateTime?
  currency       String
  notes          String?
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  shipTo       Location            @relation(fields: [shipToLocationId], references: [id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  shipments    Shipment[]
  receipts     GoodsReceipt[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, supplierId, createdAt])
}

model PurchaseOrderLine {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  productVariantId String
  orderedQty       Decimal @db.Decimal(18,4)
  receivedQty      Decimal @default(0) @db.Decimal(18,4)
  unitCost         Decimal @db.Decimal(18,4)

  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  receiptLines   GoodsReceiptLine[]
  shipmentLines  ShipmentLine[]

  @@index([purchaseOrderId])
  @@index([productVariantId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  locationId      String
  number          String
  receivedAt      DateTime @default(now())
  receivedBy      String
  additionalCosts Decimal  @default(0) @db.Decimal(18,4)
  notes           String?
  createdAt       DateTime @default(now())

