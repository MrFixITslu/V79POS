  productVariantId String
  expectedQty      Decimal  @db.Decimal(18,4)
  countedQty       Decimal? @db.Decimal(18,4)
  varianceQty      Decimal? @db.Decimal(18,4)
  countedBy        String?
  countedAt        DateTime?
  notes            String?

  stockCount     StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productVariantId])
  @@index([productVariantId])
}

model RegisterSession {
  id              String                @id @default(cuid())
  tenantId        String
  registerId      String
  locationId      String
  status          RegisterSessionStatus @default(OPEN)
  openedBy        String
  openingFloat    Decimal               @default(0) @db.Decimal(18,4)
  openedAt        DateTime              @default(now())
  closedBy        String?
  closedAt        DateTime?
  closingCash     Decimal?              @db.Decimal(18,4)
  expectedCash    Decimal?              @db.Decimal(18,4)
  cashVariance    Decimal?              @db.Decimal(18,4)
  closingNotes    String?
  denominationCount Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  register     Register       @relation(fields: [registerId], references: [id], onDelete: Restrict)
  sales        Sale[]
  cashMovements CashMovement[]
  payments Payment[]

  @@index([tenantId, registerId, status])
  @@index([tenantId, locationId, openedAt])
}

model CashMovement {
  id                String           @id @default(cuid())
  tenantId          String
  registerSessionId String
  type              CashMovementType
  amount            Decimal          @db.Decimal(18,4)
  reason            String
  performedBy       String
  createdAt         DateTime         @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session RegisterSession @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)

  @@index([tenantId, registerSessionId, createdAt])
}


model IntegrationEndpoint {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  targetType      String
  url             String
  eventTypes      String[]
  encryptedSecret String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries OutboxDelivery[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model OutboxDelivery {
  id            String   @id @default(cuid())
  outboxEventId String
  endpointId    String
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  deliveredAt   DateTime?
  responseCode  Int?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event    OutboxEvent        @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  endpoint IntegrationEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([outboxEventId, endpointId])
  @@index([deliveredAt, nextAttemptAt])
}

model AuditEvent {
  id           String   @id @default(cuid())
  tenantId     String
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ipAddress    String?
  deviceId     String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  tenantId      String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  publishedAt   DateTime?
  attempts      Int      @default(0)
  lastError     String?
  createdAt     DateTime @default(now())

  deliveries OutboxDelivery[]

  @@index([publishedAt, createdAt])
  @@index([tenantId, eventType, createdAt])
}


// Idempotent technician consumption record. Location is the technician's MOBILE stock custody.
model TechnicianUsage {
  id               String   @id @default(cuid())
  tenantId         String
  technicianUserId String
  locationId       String
  productVariantId String
  quantity         Decimal  @db.Decimal(18,4)
  jobReference     String
  requestKey       String
  unitCost         Decimal  @db.Decimal(18,4)
  serialNumberIds  Json?
  lotAllocations   Json?
  createdAt        DateTime @default(now())

  @@unique([tenantId, requestKey])
  @@index([tenantId, technicianUserId, createdAt])
  @@index([tenantId, locationId, productVariantId])
}
