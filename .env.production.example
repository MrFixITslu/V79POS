NODE_ENV=production
PORT=8080
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
# DATABASE_URL is built at container start from POSTGRES_PASSWORD (URL encoded).
REDIS_URL=redis://redis:6379

AUTH_MODE=hub
JWT_ISSUER=https://hub.v79sl.com
JWT_AUDIENCE=v79-commerce
HUB_JWKS_URL=http://v79-hub:3040/.well-known/jwks.json
HUB_INTERNAL_URL=http://v79-hub:3040
POS_PUBLIC_URL=https://pos.v79sl.com
POS_SESSION_HOURS=8
V79_PLATFORM_SHARED_SECRET=REPLACE_WITH_THE_SAME_PLATFORM_SHARED_SECRET_USED_BY_V79_HUB
CORS_ORIGINS=https://pos.v79sl.com

REPLENISHMENT_INTERVAL_MINUTES=60
LOG_LEVEL=info
TRUST_PROXY=true

GIFT_CARD_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

PROXY_NETWORK=proxy_network
BACKUP_RETENTION_DAYS=30
